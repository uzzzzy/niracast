# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source and script files
*.go text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Project configurations and hooks
Dockerfile text eol=lf
.githooks/* text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
