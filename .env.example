# Host port exposed for the web UI, HLS and IPTV feeds
PORT=8080
# Host folder with video files (mounted read-only at /media)
MEDIA_PATH=./media
# Admin password for CMS management (empty = random 20-char password generated at startup and logged once)
ADMIN_PASSWORD=
# HMAC session signing secret (empty = random 32 bytes generated per process, logged once; sessions reset on restart)
SESSION_SECRET=
