#!/bin/sh
set -e

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$BRANCH" = "main" ] && [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
  echo "Error: Direct commits to 'main' branch are prohibited." >&2
  echo "Please branch from 'develop' or set ALLOW_MAIN_COMMIT=1 if explicitly intended." >&2
  exit 1
fi

UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
  echo "Error: Go files not formatted with gofmt:" >&2
  echo "$UNFORMATTED" >&2
  echo "Run 'gofmt -w .' to format." >&2
  exit 1
fi

if ! go vet ./...; then
  echo "Error: 'go vet ./...' failed." >&2
  exit 1
fi

if ! go build ./...; then
  echo "Error: 'go build ./...' failed." >&2
  exit 1
fi

exit 0
